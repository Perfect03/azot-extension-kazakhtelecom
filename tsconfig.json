{
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",
    "declaration": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "target": "ESNext",
    "lib": ["ESNext"],
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["main.ts"],
  "exclude": ["node_modules"]
}
